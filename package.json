{
  "name": "storage-goblin",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:commands": "cargo test --manifest-path src-tauri/Cargo.toml --features tauri-command-tests",
    "generate:types": "cargo test --manifest-path src-tauri/Cargo.toml -- --ignored regenerate_",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@goblin-systems/goblin-design-system": "^1.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "lucide": "^0.577.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^10.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
